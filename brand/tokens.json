{
  "$source": "https://vovoscan.yieldgrowth.org/ (CSS: /_next/static/css/4184d66db21bc378.css, 51b56969b6725e6b.css; icon: /icon.svg)",
  "color": {
    "ink":      { "value": "#0b0b0e", "role": "app background, text on red/yellow/cyan" },
    "ink2":     { "value": "#15151b", "role": "panels, cards, player" },
    "line":     { "value": "#2a2a33", "role": "borders in app UI" },
    "paper":    { "value": "#f3eee4", "role": "primary text, light surfaces, outlines" },
    "paper2":   { "value": "#e6dfd1", "role": "secondary light surface" },
    "muted":    { "value": "#a39e94", "role": "secondary text (app)" },
    "red":      { "value": "#ff2d55", "role": "ACCENT / primary action / links" },
    "yellow":   { "value": "#ffd60a", "role": "highlight, stickers, SFX, warnings" },
    "cyan":     { "value": "#2de2e6", "role": "audio/voice, scanning, secondary accent" },
    "danger":   { "value": "#ff6b6b", "role": "error text" },
    "inputBg":  { "value": "#0b0c10", "role": "input fields" }
  },
  "alpha": { "borderSubtle": "#ffffff1f", "borderFaint": "#ffffff14", "textSoft": "#f3eee4c2", "textDim": "#f3eee4a8" },
  "font": {
    "display": { "family": "Dela Gothic One", "weight": 400, "use": "logo, titles, numbers, SFX, buttons-as-labels" },
    "body":    { "family": "Space Grotesk", "weight": "300-700 variable", "use": "all UI and body text" },
    "cjkSfx":  "Japanese onomatopoeia rendered in the display font"
  },
  "type": { "body": "15px/1.5", "lede": "16-19px/1.6", "h1App": "26px", "h3": "22px/1.15", "kicker": "12px 700 uppercase tracking .12em", "label": "13px" },
  "radius": { "card": 12, "input": 8, "button": 8, "pill": 999, "landing": 0 },
  "border": { "hard": "2-3px solid paper/ink" },
  "shadow": {
    "hardRed":   "6px 6px 0 2px paper (primary button)",
    "navCta":    "3px 3px 0 red",
    "playerCyan":"6px 6px 0 cyan",
    "sheet":     "14px 14px 0 red",
    "sticker":   "3px 3px 0 ink"
  },
  "motion": { "hoverLift": "translate(-2px,-2px) + shadow grows", "durationFast": "150ms", "durationCard": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)", "tilt": "-6deg logo, -2deg kicker, ±1.5deg cards" },
  "spacing": { "pageMax": 1240, "appMax": 880, "gutter": "clamp(16px,4vw,48px)", "gap": 14 }
}
