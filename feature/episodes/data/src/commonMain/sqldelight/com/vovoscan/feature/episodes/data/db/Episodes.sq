-- The last known episode of each chapter opened (the API's EpisodeOut as JSON), and the last watch of each chapter
-- (timeline and signed URLs, WatchOut as JSON): offline, the screen keeps the last state; the player refetches the
-- watch when its URLs come close to expiring.
CREATE TABLE episode (
    chapter_id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    body TEXT NOT NULL
);

CREATE TABLE watch (
    chapter_id TEXT NOT NULL PRIMARY KEY,
    render_key TEXT NOT NULL,
    expires_at INTEGER NOT NULL,
    body TEXT NOT NULL
);

episode:
SELECT body FROM episode WHERE chapter_id = ?;

episodeUpdatedAt:
SELECT updated_at FROM episode WHERE chapter_id = ?;

putEpisode:
INSERT OR REPLACE INTO episode (chapter_id, status, updated_at, body) VALUES (?, ?, ?, ?);

deleteEpisode:
DELETE FROM episode WHERE chapter_id = ?;

watch:
SELECT * FROM watch WHERE chapter_id = ?;

putWatch:
INSERT OR REPLACE INTO watch (chapter_id, render_key, expires_at, body) VALUES (?, ?, ?, ?);

clearEpisodes:
DELETE FROM episode;

clearWatches:
DELETE FROM watch;
