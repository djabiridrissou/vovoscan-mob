-- Units already opened, reread offline. A unit is identified by "source/id".
-- Comic: its pages (images come from the image cache). Book: its sanitized sections, readable without a network.
CREATE TABLE reader_chapter (
    chapter_key TEXT NOT NULL PRIMARY KEY,
    source_key TEXT NOT NULL,
    id TEXT NOT NULL,
    title_id TEXT NOT NULL,
    title_name TEXT NOT NULL,
    number REAL NOT NULL,
    name TEXT,
    kind TEXT NOT NULL,
    format TEXT NOT NULL,
    previous_id TEXT,
    next_id TEXT,
    document_url TEXT
);

CREATE TABLE reader_page (
    chapter_key TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    url TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    PRIMARY KEY (chapter_key, page_index)
);

CREATE TABLE book_section (
    chapter_key TEXT NOT NULL,
    section_index INTEGER NOT NULL,
    title TEXT NOT NULL,
    html TEXT NOT NULL,
    PRIMARY KEY (chapter_key, section_index)
);

-- Reader settings kept on this device (no backend): one row per setting, value as text.
CREATE TABLE reader_setting (
    name TEXT NOT NULL PRIMARY KEY,
    setting_value TEXT NOT NULL
);

-- The reading mode the user chose for one series, overriding the defaults.
CREATE TABLE series_mode (
    source_key TEXT NOT NULL,
    title_id TEXT NOT NULL,
    mode TEXT NOT NULL,
    PRIMARY KEY (source_key, title_id)
);

-- Chapters chosen for offline reading, in the order they were asked for (one downloads at a time).
-- state: queued | waiting | downloading | done | failed. kind: comic (pages as files) | book (its file, stored as
-- sections in book_section; the row goes once the book is saved, the saved book then shows as any opened book).
CREATE TABLE download (
    chapter_key TEXT NOT NULL PRIMARY KEY,
    source_key TEXT NOT NULL,
    title_id TEXT NOT NULL,
    chapter_id TEXT NOT NULL,
    title_name TEXT NOT NULL,
    label TEXT NOT NULL,
    number REAL NOT NULL,
    state TEXT NOT NULL,
    page_count INTEGER NOT NULL,
    error TEXT,
    requested_at INTEGER NOT NULL,
    kind TEXT NOT NULL DEFAULT 'comic'
);

-- A downloaded page: its file, relative to the downloads folder (the iOS container's path changes with updates).
CREATE TABLE download_page (
    chapter_key TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    file_path TEXT NOT NULL,
    bytes INTEGER NOT NULL,
    PRIMARY KEY (chapter_key, page_index)
);

chapter:
SELECT * FROM reader_chapter WHERE chapter_key = ?;

pages:
SELECT * FROM reader_page WHERE chapter_key = ? ORDER BY page_index;

putChapter:
INSERT OR REPLACE INTO reader_chapter (chapter_key, source_key, id, title_id, title_name, number, name, kind, format, previous_id, next_id, document_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePages:
DELETE FROM reader_page WHERE chapter_key = ?;

putPage:
INSERT OR REPLACE INTO reader_page (chapter_key, page_index, url, width, height) VALUES (?, ?, ?, ?, ?);

sections:
SELECT section_index, title FROM book_section WHERE chapter_key = ? ORDER BY section_index;

sectionHtml:
SELECT html FROM book_section WHERE chapter_key = ? AND section_index = ?;

putSection:
INSERT OR REPLACE INTO book_section (chapter_key, section_index, title, html) VALUES (?, ?, ?, ?);

deleteSections:
DELETE FROM book_section WHERE chapter_key = ?;

clearChapters:
DELETE FROM reader_chapter;

clearPages:
DELETE FROM reader_page;

clearSections:
DELETE FROM book_section;

clearPagesOf:
DELETE FROM reader_page WHERE chapter_key IN (SELECT chapter_key FROM reader_chapter WHERE source_key = ?);

clearSectionsOf:
DELETE FROM book_section WHERE chapter_key IN (SELECT chapter_key FROM reader_chapter WHERE source_key = ?);

clearChaptersOf:
DELETE FROM reader_chapter WHERE source_key = ?;

settings:
SELECT * FROM reader_setting WHERE name NOT LIKE 'pos/%' AND name NOT LIKE 'last/%' AND name NOT LIKE 'seriesPending/%' AND name <> 'seriesMigrated' AND name <> 'readLanguage'
  AND name NOT LIKE 'historyPending/%' AND name <> 'historySince';

putSetting:
INSERT OR REPLACE INTO reader_setting (name, setting_value) VALUES (?, ?);

seriesMode:
SELECT mode FROM series_mode WHERE source_key = ? AND title_id = ?;

putSeriesMode:
INSERT OR REPLACE INTO series_mode (source_key, title_id, mode) VALUES (?, ?, ?);

deleteSeriesMode:
DELETE FROM series_mode WHERE source_key = ? AND title_id = ?;

clearSeriesModes:
DELETE FROM series_mode;

allSeriesModes:
SELECT source_key, title_id, mode FROM series_mode;

-- Series modes chosen on the device and not on the account yet ("seriesPending/<sourceKey>:<titleRef>" = mode or "-"),
-- and "seriesMigrated" once the device's earlier choices were sent.
pendingSeriesModes:
SELECT name, setting_value FROM reader_setting WHERE name LIKE 'seriesPending/%';

deleteSetting:
DELETE FROM reader_setting WHERE name = ?;

clearSeriesModesOf:
DELETE FROM series_mode WHERE source_key = ?;

setting:
SELECT setting_value FROM reader_setting WHERE name = ?;

-- Reading positions ("pos/<source>/<chapter>" = "<page>:<share of the page above the screen's top>").
clearPositions:
DELETE FROM reader_setting WHERE name LIKE 'pos/%' OR name LIKE 'last/%' OR name LIKE 'seriesPending/%' OR name = 'seriesMigrated' OR name = 'readLanguage'
  OR name LIKE 'historyPending/%' OR name = 'historySince';

-- The chapter each title was left at ("last/<source>/<title>" = "<time ms>:<page>:<chapter id>").
history:
SELECT name, setting_value FROM reader_setting WHERE name LIKE 'last/%';

-- Places read on the device and not on the account yet ("historyPending/<source>/<title>" = the same value as "last/"),
-- and "historySince" = the time (ms) of the newest account place taken, where the next pull starts.
pendingHistory:
SELECT name, setting_value FROM reader_setting WHERE name LIKE 'historyPending/%';

clearPositionsOf:
DELETE FROM reader_setting WHERE name LIKE ?;

downloads:
SELECT d.chapter_key, d.source_key, d.title_id, d.chapter_id, d.title_name, d.label, d.number, d.state, d.page_count, d.error,
       d.kind, COUNT(p.page_index) AS pages_done, TOTAL(p.bytes) AS bytes
FROM download d LEFT JOIN download_page p ON p.chapter_key = d.chapter_key
GROUP BY d.chapter_key
ORDER BY d.title_name, d.number;

titleDownloads:
SELECT d.chapter_key, d.source_key, d.title_id, d.chapter_id, d.title_name, d.label, d.number, d.state, d.page_count, d.error,
       d.kind, COUNT(p.page_index) AS pages_done, TOTAL(p.bytes) AS bytes
FROM download d LEFT JOIN download_page p ON p.chapter_key = d.chapter_key
WHERE d.source_key = ? AND d.title_id = ?
GROUP BY d.chapter_key
ORDER BY d.number;

download:
SELECT * FROM download WHERE chapter_key = ?;

nextQueued:
SELECT * FROM download WHERE state = 'queued' ORDER BY requested_at, number LIMIT 1;

putDownload:
INSERT OR IGNORE INTO download (chapter_key, source_key, title_id, chapter_id, title_name, label, number, state, page_count, error, requested_at, kind)
VALUES (?, ?, ?, ?, ?, ?, ?, 'queued', 0, NULL, ?, ?);

-- What is still to download (background work, the notification's Cancel).
unfinishedDownloads:
SELECT source_key, chapter_id FROM download WHERE state IN ('queued', 'waiting', 'downloading');

setDownloadState:
UPDATE download SET state = ?, error = ? WHERE chapter_key = ?;

setDownloadPageCount:
UPDATE download SET page_count = ? WHERE chapter_key = ?;

requeueInterrupted:
UPDATE download SET state = 'queued' WHERE state IN ('waiting', 'downloading');

deleteDownload:
DELETE FROM download WHERE chapter_key = ?;

downloadPages:
SELECT page_index, file_path FROM download_page WHERE chapter_key = ?;

putDownloadPage:
INSERT OR REPLACE INTO download_page (chapter_key, page_index, file_path, bytes) VALUES (?, ?, ?, ?);

deleteDownloadPages:
DELETE FROM download_page WHERE chapter_key = ?;

clearDownloads:
DELETE FROM download;

clearDownloadPages:
DELETE FROM download_page;

clearDownloadPagesOf:
DELETE FROM download_page WHERE chapter_key IN (SELECT chapter_key FROM download WHERE source_key = ?);

clearDownloadsOf:
DELETE FROM download WHERE source_key = ?;

-- Books opened (or downloaded) on this device: their sections are kept, readable offline.
savedBooks:
SELECT c.chapter_key, c.source_key, c.title_id, c.id, c.title_name, c.name, c.number, TOTAL(LENGTH(CAST(s.html AS BLOB))) AS bytes
FROM reader_chapter c JOIN book_section s ON s.chapter_key = c.chapter_key
GROUP BY c.chapter_key
ORDER BY c.title_name, c.number;

titleSavedBooks:
SELECT c.chapter_key, c.source_key, c.title_id, c.id, c.title_name, c.name, c.number, TOTAL(LENGTH(CAST(s.html AS BLOB))) AS bytes
FROM reader_chapter c JOIN book_section s ON s.chapter_key = c.chapter_key
WHERE c.source_key = ? AND c.title_id = ?
GROUP BY c.chapter_key
ORDER BY c.number;
