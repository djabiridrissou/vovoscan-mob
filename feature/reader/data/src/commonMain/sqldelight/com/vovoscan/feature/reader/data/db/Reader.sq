-- Unités déjà ouvertes, relues hors ligne. Une unité est repérée par « source/identifiant ».
-- Comic : ses pages (les images viennent du cache d'images). Livre : ses sections nettoyées, lisibles sans réseau.
CREATE TABLE reader_chapter (
    chapter_key TEXT NOT NULL PRIMARY KEY,
    source_key TEXT NOT NULL,
    id TEXT NOT NULL,
    title_id TEXT NOT NULL,
    title_name TEXT NOT NULL,
    number REAL NOT NULL,
    name TEXT,
    kind TEXT NOT NULL,
    format TEXT NOT NULL,
    previous_id TEXT,
    next_id TEXT,
    document_url TEXT
);

CREATE TABLE reader_page (
    chapter_key TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    url TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    PRIMARY KEY (chapter_key, page_index)
);

CREATE TABLE book_section (
    chapter_key TEXT NOT NULL,
    section_index INTEGER NOT NULL,
    title TEXT NOT NULL,
    html TEXT NOT NULL,
    PRIMARY KEY (chapter_key, section_index)
);

chapter:
SELECT * FROM reader_chapter WHERE chapter_key = ?;

pages:
SELECT * FROM reader_page WHERE chapter_key = ? ORDER BY page_index;

putChapter:
INSERT OR REPLACE INTO reader_chapter (chapter_key, source_key, id, title_id, title_name, number, name, kind, format, previous_id, next_id, document_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePages:
DELETE FROM reader_page WHERE chapter_key = ?;

putPage:
INSERT OR REPLACE INTO reader_page (chapter_key, page_index, url, width, height) VALUES (?, ?, ?, ?, ?);

sections:
SELECT section_index, title FROM book_section WHERE chapter_key = ? ORDER BY section_index;

sectionHtml:
SELECT html FROM book_section WHERE chapter_key = ? AND section_index = ?;

putSection:
INSERT OR REPLACE INTO book_section (chapter_key, section_index, title, html) VALUES (?, ?, ?, ?);

deleteSections:
DELETE FROM book_section WHERE chapter_key = ?;

clearChapters:
DELETE FROM reader_chapter;

clearPages:
DELETE FROM reader_page;

clearSections:
DELETE FROM book_section;
