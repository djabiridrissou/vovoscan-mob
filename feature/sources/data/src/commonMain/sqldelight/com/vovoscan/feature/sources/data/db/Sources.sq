-- Mes sources, gardées sur l'appareil : liste, ordre, visibilité ; manifeste et réglages des sources lues sur
-- l'appareil (pour les lire hors ligne aussi).
CREATE TABLE source (
    key TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    engine TEXT NOT NULL,
    version TEXT NOT NULL,
    kinds TEXT NOT NULL,
    langs TEXT NOT NULL,
    enabled INTEGER NOT NULL,
    position INTEGER NOT NULL,
    manifest TEXT,
    settings TEXT
);

-- Dernier choix (visibles, ordre) pas encore envoyé : une seule ligne, la plus récente remplace l'autre.
CREATE TABLE pending_choices (
    slot INTEGER NOT NULL PRIMARY KEY CHECK (slot = 1),
    payload TEXT NOT NULL
);

all:
SELECT * FROM source ORDER BY position, name;

manifest:
SELECT manifest, settings FROM source WHERE key = ? AND manifest IS NOT NULL;

put:
INSERT OR REPLACE INTO source (key, name, engine, version, kinds, langs, enabled, position, manifest, settings)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setChoice:
UPDATE source SET enabled = ?, position = ? WHERE key = ?;

clearSources:
DELETE FROM source;

pending:
SELECT payload FROM pending_choices WHERE slot = 1;

putPending:
INSERT OR REPLACE INTO pending_choices (slot, payload) VALUES (1, ?);

clearPending:
DELETE FROM pending_choices;
