<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the mark on ink (the launcher icon's foreground), then the app's own launch stamp. -->
    <style name="Theme.Vovoscan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
