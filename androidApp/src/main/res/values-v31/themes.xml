<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the balloon mark (splash_mark, within the 192 dp circle) on ink, no icon tile. -->
    <style name="Theme.Vovoscan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ink</item>
    </style>
</resources>
