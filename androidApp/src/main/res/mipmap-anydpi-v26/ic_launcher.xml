<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): ink background, the mark in the foreground, the mark again as the themed
     (monochrome) icon. Replacing ic_launcher_foreground / ic_launcher_monochrome changes it everywhere. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
